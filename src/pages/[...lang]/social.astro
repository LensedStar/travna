---
// social.astro — Hidden advertising landing (TASK-025): the one page social profiles and paid
// social (Meta) campaigns link to. The file name is the URL, in every locale: /social, /sl/social,
// /ru/social.
// Renaming it means updating two more places by hand: the sitemap filter in astro.config.mjs and the
// Disallow lines in public/robots.txt. (The dictionary keys keep their short `lp.*` prefix.)
// It wears the normal site header and footer like every other page (it started out with a minimal
// bar of its own; the user asked for the normal navigation back). Still noindex,nofollow (BaseLayout
// `noindex`), excluded from the sitemap (filter in astro.config.mjs) and NOT linked from the nav.
//
// Top → bottom, built from the blocks the other pages already use:
//   1. Hero            → the home hero (ParallaxHero) with the landing's own headline
//   2. The place       → the home welcome block (circular house photo + description)
//   3. Rooms           → LandingFeature (showcase slider + copy)
//   4. Atmosphere      → LandingAtmosphere (a short text with six photos around it)
//   5. Sauna           → LandingFeature
//   6. Activities      → LandingActivities (four small blocks + the one link out, to /activities)
//   7. Restaurant      → LandingFeature, then the dishes guests keep mentioning (LandingMenu)
//                        across the full width under it
//   8. Guest reviews   → Testimonials
//   9. Reservation     → the Bentral widget itself (LandingReservation) — the page ends where the
//                        booking happens, so every CTA scrolls here instead of leaving the page.
// The conversion goal lives in ONE place (components/sections/landingGoal.ts); swap section 9
// together with it. Visible strings come from the i18n dictionary — the landing's own copy under
// `lp.*`, so rewording this page never changes the pages the blocks come from; styling lives in
// src/styles/blocks/_landing.scss.
import BaseLayout from '../../layouts/BaseLayout.astro';
import ParallaxHero from '../../islands/ParallaxHero.jsx';
import HomeWelcome from '../../components/sections/HomeWelcome.astro';
import LandingFeature from '../../components/sections/LandingFeature.astro';
import LandingAtmosphere from '../../components/sections/LandingAtmosphere.astro';
import LandingActivities from '../../components/sections/LandingActivities.astro';
import LandingMenu from '../../components/sections/LandingMenu.astro';
import LandingReservation from '../../components/sections/LandingReservation.astro';
import LandingCTA from '../../components/sections/LandingCTA.astro';
import Testimonials from '../../components/sections/Testimonials.astro';
import { landingGoals, activeLandingGoal } from '../../components/sections/landingGoal';
import { saunaPhotos } from '../../components/sections/saunaPhotos';
import { useTranslations, localeStaticPaths } from '../../i18n';

const t = useTranslations(Astro.currentLocale);
const pageTitle = `${t('lp.hero.title')} — ${t('site.name')}`;
const goal = landingGoals[activeLandingGoal];

// Showcase photos are the real client photos under public/images/<folder>/, each with a small
// thumbnail beside it in <folder>/thumbs/ (scripts/make-image-derivatives.mjs).
const photo = (folder: string, name: string, alt: string) => ({
  src: `/images/${folder}/${name}.webp`,
  thumb: `/images/${folder}/thumbs/${name}.webp`,
  alt,
});

const stayImages = [
  photo('rooms', 'rooms-01', t('lp.stay.alt.balcony')),
  photo('rooms', 'rooms-06', t('accommodation.units.rooms.alt')),
  photo('rooms', 'rooms-08', t('lp.stay.alt.attic')),
  photo('rooms', 'rooms-10', t('home.apartments.rooms.alt')),
  photo('house3', 'house3-01', t('accommodation.units.house3.alt1')),
  photo('rooms', 'rooms-07', t('lp.stay.alt.bathroom')),
];

// The same photo set as the Sauna block of the other pages.
const saunaImages = saunaPhotos(t);

const restaurantImages = ['kitchen-02', 'kitchen-05', 'kitchen-06', 'kitchen-01', 'kitchen-03', 'kitchen-04'].map(
  (name) => photo('kitchen', name, t('lp.restaurant.imageAlt'))
);

// One build per locale: `lang` is undefined for EN (unprefixed), 'sl' / 'ru' for the others.
export const getStaticPaths = localeStaticPaths;
---
<BaseLayout title={pageTitle} description={t('lp.meta.description')} ogImage="/images/og-lp.jpg" noindex>
  <div class="landing">
    <ParallaxHero
      client:load
      title={t('lp.hero.title')}
      subtitle={t('lp.hero.subtitle')}
      intro={t('lp.hero.intro')}
      bookHref={`#${goal.anchor}`}
      bookConversion={goal.conversion}
      ctaPrimaryLabel={t(goal.labelKey)}
      ratingsLabel={t('home.hero.ratingsLabel')}
      bookingLabel={t('home.hero.bookingLabel')}
      airbnbLabel={t('home.hero.airbnbLabel')}
    />

    <HomeWelcome
      id="place"
      title={t('lp.place.title')}
      lead={t('lp.place.text')}
      pills={[
        { icon: 'bed', label: t('home.welcome.pill.apartments') },
        { icon: 'flame', label: t('home.welcome.pill.kitchen') },
        { icon: 'trees', label: t('lp.place.pill.nature') },
      ]}
    >
      <LandingCTA slot="cta" variant="secondary" />
    </HomeWelcome>

    <LandingFeature
      id="stay"
      warm
      matchHeight
      eyebrow={t('accommodation.units.eyebrow')}
      title={t('lp.stay.title')}
      text={t('lp.stay.text')}
      images={stayImages}
      points={[t('lp.stay.point1'), t('lp.stay.point2')]}
      pointIcon="bed"
      pills={[
        { icon: 'paw-print', label: t('accommodation.hero.pill.pets') },
        { icon: 'parking', label: t('accommodation.hero.pill.parking') },
        { icon: 'wifi', label: t('accommodation.hero.pill.wifi') },
      ]}
    >
      <LandingCTA slot="cta" />
    </LandingFeature>

    <LandingAtmosphere id="atmosphere" />

    <LandingFeature
      id="sauna"
      mirror
      title={t('sauna.title')}
      text={t('lp.sauna.text')}
      images={saunaImages}
      points={[t('lp.sauna.point1'), t('lp.sauna.point2'), t('lp.sauna.point3')]}
      pointIcon="flame"
    />

    <LandingActivities id="activities" />

    <LandingFeature
      id="restaurant"
      warm
      eyebrow={t('lp.restaurant.eyebrow')}
      title={t('lp.restaurant.title')}
      text={t('lp.restaurant.text')}
      images={restaurantImages}
      pills={[
        { icon: 'coffee', label: t('menu.hero.pill.breakfast') },
        { icon: 'utensils', label: t('lp.restaurant.pill.mains') },
        { icon: 'leaf', label: t('menu.hero.pill.soups') },
      ]}
    >
      <LandingMenu slot="foot" />
    </LandingFeature>

    <Testimonials title={t('lp.reviews.title')} intro={t('lp.reviews.intro')} />

    <LandingReservation />
  </div>
</BaseLayout>
