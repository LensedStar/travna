---
// Header.astro — global site header (TASK-010).
// image logo (brand, links to /), primary nav (i18n strings), prominent "Book" CTA -> /rezervacija.
// Reserves slots for the LanguageSwitcher island (TASK-011) and the MobileNav island (TASK-012),
// which mount their React islands here in their own tasks. All visible text comes from the i18n dictionary.
import { useTranslations, localizePath, stripLocale, resolveLocale, locales } from '../../i18n';
import type { UIKey } from '../../i18n/types';
import Button from '../ui/Button.astro';
import LanguageSwitcher from '../../islands/LanguageSwitcher.jsx';
import MobileNav from '../../islands/MobileNav.jsx';

const t = useTranslations(Astro.currentLocale);
const lang = resolveLocale(Astro.currentLocale);

const navLinks = [
  { href: localizePath('/', lang), label: t('nav.home') },
  { href: localizePath('/accommodation', lang), label: t('nav.accommodation') },
  { href: localizePath('/activities', lang), label: t('nav.activities') },
  { href: localizePath('/menu', lang), label: t('nav.menu') },
  { href: localizePath('/contact', lang), label: t('nav.contact') },
  { href: localizePath('/rezervacija', lang), label: t('nav.book') },
];

// Language switcher options: the SAME page in every configured locale. The current path has its
// locale prefix stripped first, so /ru/activities offers /activities and vice versa. Labels are
// dictionary entries ('lang.en', 'lang.ru'), so adding a locale needs no edit here.
const currentPath = stripLocale(Astro.url.pathname);
const langOptions = locales.map((code) => ({
  code,
  label: t(`lang.${code}` as UIKey),
  href: localizePath(currentPath, code),
  current: code === lang,
}));
---

<header class="site-header">
  <div class="site-header__inner">
    <a class="site-header__brand" href={localizePath('/', lang)} aria-label={t('site.name')}>
      <img
        class="site-header__logo"
        src="/images/logo.png"
        alt={t('site.name')}
        width="512"
        height="512"
        decoding="async"
      />
    </a>

    <nav class="site-header__nav" aria-label={t('a11y.primaryNav')}>
      <ul class="site-header__nav-list">
        {
          navLinks.map((link) => (
            <li class="site-header__nav-item">
              <a class="site-header__nav-link" href={link.href}>
                {link.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <div class="site-header__actions">
      <LanguageSwitcher
        client:idle
        currentLabel={t(`lang.${lang}` as UIKey)}
        menuLabel={t('lang.label')}
        options={langOptions}
      />
      <Button href={localizePath('/rezervacija', lang)} class="site-header__book">{t('nav.book')}</Button>
      <MobileNav
        client:idle
        links={navLinks}
        bookHref={localizePath('/rezervacija', lang)}
        bookLabel={t('nav.book')}
        openLabel={t('a11y.openMenu')}
        closeLabel={t('a11y.closeMenu')}
        navLabel={t('a11y.primaryNav')}
      />
    </div>
  </div>
</header>
