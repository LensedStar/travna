---
// LandingCTA.astro — swappable conversion CTA for the hidden landing (/social) (TASK-025).
// The landing's conversion goal lives in ONE place (landingGoal.ts). To change the goal later —
// e.g. from booking to an inquiry form or a special-offer capture — change it there; this
// component and the /social page's buttons follow.
// The CTA is marked as the key conversion via `data-conversion` for future campaign tracking.
import Button from '../ui/Button.astro';
import Icon from '../ui/Icon.astro';
import { useTranslations } from '../../i18n';
import { landingGoals, activeLandingGoal, type LandingGoal } from './landingGoal';

interface Props {
  goal?: LandingGoal;
  variant?: 'primary' | 'secondary';
  class?: string;
}
const { goal = activeLandingGoal, variant = 'primary', class: className } = Astro.props;
const t = useTranslations(Astro.currentLocale);

const { anchor, labelKey, conversion } = landingGoals[goal];

const classes = ['landing__cta', className].filter(Boolean).join(' ');
---
<Button href={`#${anchor}`} variant={variant} class={classes} data-conversion={conversion}>
  <Icon name="calendar" class="landing__cta-icon" />
  <span>{t(labelKey)}</span>
</Button>
