---
// HomeWelcome.astro — Home "welcome to the house" block (replaces the old Dolenjska region block).
// First section after the hero: the circular house photo rises up into the hero's wave so the
// landscape photography and the house photo read as one composition, beside editorial copy in the
// same visual language as the accommodation/activities page heroes (offset ring + scattered leaves
// + round badge + divider + pills). Pure .astro, zero client JS. Visible strings come from the
// i18n dictionary; styling lives in src/styles/blocks/_home-welcome.scss. Copy is MOCK placeholder
// (see en.ts // TODO).
// Also opens the landing (/social) under the same hero: there it gets an anchor `id`, the landing's
// own title, text and pills, and swaps the button for the landing's own CTA through the `cta` slot.
import Button from '../ui/Button.astro';
import Icon from '../ui/Icon.astro';
import { useTranslations, localizePath } from '../../i18n';

interface Props {
  id?: string;
  // Copy overrides — the home page passes none and gets the home strings below. The landing passes
  // three pills, not four: a fourth sat alone on a row of its own and pushed the button down.
  title?: string;
  lead?: string;
  pills?: { icon: string; label: string }[];
}
const t = useTranslations(Astro.currentLocale);

// House-highlight pills — line-icon + label. Reorder/extend here without touching the layout.
const homePills = [
  { icon: 'bed', label: t('home.welcome.pill.apartments') },
  { icon: 'flame', label: t('home.welcome.pill.kitchen') },
  { icon: 'trees', label: t('home.welcome.pill.forest') },
  { icon: 'paw-print', label: t('home.welcome.pill.pets') },
];

const {
  id,
  title = t('home.welcome.title'),
  lead = t('home.welcome.lead'),
  pills = homePills,
} = Astro.props;
---
<section class="home-welcome reveal" id={id}>
  <div class="home-welcome__inner">
    <div class="home-welcome__media-col">
      <div class="home-welcome__ring" aria-hidden="true"></div>

      <div class="home-welcome__media">
        {/* WebP derivative of post-hero-main-house-image.png — see scripts/make-image-derivatives.mjs. */}
        <img
          class="home-welcome__photo"
          src="/images/post-hero-main-house-image.webp"
          alt={t('home.welcome.imageAlt')}
          width="800"
          height="1069"
          loading="eager"
          decoding="async"
        />
      </div>

      <!-- Scattered botanical leaves — purely decorative atmosphere. -->
      <Icon name="leaf" class="home-welcome__leaf home-welcome__leaf--tr" />
      <Icon name="leaf" class="home-welcome__leaf home-welcome__leaf--bl" />
      <Icon name="leaf" class="home-welcome__leaf home-welcome__leaf--bl2" />
    </div>

    <div class="home-welcome__body">
      <h2 class="home-welcome__title">{title}</h2>

      <p class="home-welcome__lead">{lead}</p>

      <ul class="home-welcome__pills" role="list">
        {pills.map(({ icon, label }) => (
          <li class="home-welcome__pill">
            <Icon name={icon} class="home-welcome__pill-icon" />
            <span>{label}</span>
          </li>
        ))}
      </ul>

      <div class="home-welcome__cta">
        <slot name="cta">
          <Button href={localizePath('/accommodation', Astro.currentLocale)} variant="secondary">{t('cta.viewAccommodation')}</Button>
        </slot>
      </div>
    </div>
  </div>
</section>
