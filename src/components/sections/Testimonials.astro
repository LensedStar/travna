---
// Testimonials.astro — guest reviews block (reusable across pages).
// Header row with the title on the left and a small Booking.com score badge on the right (one
// line), a subtitle below, then a one-at-a-time carousel of quote cards, each with a 5-star row,
// the quote, and the guest's name + meta. Doesn't use the shared SectionHeader primitive because
// of the title+badge row — reuses its `.section-header__*` classes directly instead. Slider
// behaviour lives in the TestimonialsSlider island (the only client JS here); styling lives in
// src/styles/blocks/_testimonials.scss. Quotes and the score are real (from Booking.com), quotes
// selected from the highest-rated reviews.
import TestimonialsSlider from '../../islands/TestimonialsSlider.jsx';
import { useTranslations } from '../../i18n';

const t = useTranslations(Astro.currentLocale);

const reviews = [
  { quote: t('testimonials.t1.quote'), author: t('testimonials.t1.author'), meta: t('testimonials.t1.meta') },
  { quote: t('testimonials.t2.quote'), author: t('testimonials.t2.author'), meta: t('testimonials.t2.meta') },
  { quote: t('testimonials.t3.quote'), author: t('testimonials.t3.author'), meta: t('testimonials.t3.meta') },
  { quote: t('testimonials.t4.quote'), author: t('testimonials.t4.author'), meta: t('testimonials.t4.meta') },
  { quote: t('testimonials.t5.quote'), author: t('testimonials.t5.author'), meta: t('testimonials.t5.meta') },
  { quote: t('testimonials.t6.quote'), author: t('testimonials.t6.author'), meta: t('testimonials.t6.meta') },
];
---
<section class="testimonials reveal">
  <div class="testimonials__inner">
    <div class="testimonials__header">
      <div class="testimonials__header-row">
        <h2 class="section-header__title">{t('testimonials.title')}</h2>
        <div class="testimonials__score" role="group" aria-label={`${t('testimonials.score.value')} — ${t('testimonials.score.label')}. ${t('testimonials.score.meta')}`}>
          <span class="testimonials__score-badge" aria-hidden="true">{t('testimonials.score.value')}</span>
          <span class="testimonials__score-text">
            <span class="testimonials__score-label" aria-hidden="true">{t('testimonials.score.label')}</span>
            <span class="testimonials__score-meta" aria-hidden="true">{t('testimonials.score.meta')}</span>
          </span>
        </div>
      </div>
      <p class="section-header__subtitle">{t('testimonials.intro')}</p>
    </div>

    <TestimonialsSlider
      client:visible
      reviews={reviews}
      label={t('testimonials.slider.label')}
      prevLabel={t('testimonials.slider.prev')}
      nextLabel={t('testimonials.slider.next')}
      ratingLabel={t('testimonials.ratingLabel')}
    />
  </div>
</section>
