---
// LandingActivities.astro — the landing's (/social) activities teaser: a heading with a short
// intro, four small blocks (photo, name and one line about it) and one link to the Activities page
// for the rest. The name and the line are the landing's own copy (`lp.activities.*`); the photo is
// the one the Activities page shows for the same entry of the `activities` / `destinations`
// collections, so it follows every swap there. Pure .astro, zero client JS.
// Visible strings come from the i18n dictionary; styling lives in src/styles/blocks/_landing.scss.
import { Image } from 'astro:assets';
import SectionHeader from '../ui/SectionHeader.astro';
import Button from '../ui/Button.astro';
import Icon from '../ui/Icon.astro';
import { useTranslations, localizePath } from '../../i18n';
import { getLocalizedCollection } from '../../i18n/content';

interface Props {
  id?: string;
}
const { id } = Astro.props;

const t = useTranslations(Astro.currentLocale);

// The four blocks, in display order: where the photo comes from (file name without .json in one of
// the two collections) and which pair of strings describes it (`lp.activities.<copy>.title` /
// `.text`). To show something else, swap the entry and rewrite that pair in every dictionary. A
// name with no matching file is skipped, so removing an entry from a collection never breaks the page.
const picks = [
  { collection: 'activities', entry: '01-hiking', copy: 'hiking' },
  { collection: 'activities', entry: '02-cycling', copy: 'cycling' },
  { collection: 'destinations', entry: '05-bear-watching', copy: 'bears' },
  { collection: 'destinations', entry: '04-krizna-cave', copy: 'cave' },
] as const;

const activities = await getLocalizedCollection('activities', Astro.currentLocale);
const destinations = await getLocalizedCollection('destinations', Astro.currentLocale);

// Entry ids are '01-hiking' in the default locale and 'ru/01-hiking' in the others.
const named = (entryId: string, name: string) => entryId.split('/').pop() === name;

const blocks = picks.flatMap(({ collection, entry, copy }) => {
  const found = (collection === 'activities' ? activities : destinations).find(({ id: entryId }) =>
    named(entryId, entry)
  );
  return found
    ? [{ name: t(`lp.activities.${copy}.title`), text: t(`lp.activities.${copy}.text`), image: found.data.image }]
    : [];
});
---
{blocks.length > 0 && (
  <section class="landing-activities reveal" id={id}>
    <div class="landing-activities__inner">
      <SectionHeader
        eyebrow={t('lp.activities.eyebrow')}
        title={t('lp.activities.title')}
        subtitle={t('lp.activities.intro')}
        align="center"
      />

      <ul class="landing-activities__list" role="list">
        {blocks.map(({ name, text, image }) => (
          <li class="landing-activities__item">
            <div class="landing-activities__media">
              {/* `sizes` in real widths: rem there ignores the site's enlarged root font size. */}
              <Image
                class="landing-activities__image"
                src={image}
                alt={name}
                widths={[160, 240, 360, 600]}
                sizes="(min-width: 90rem) 18.5rem, (min-width: 72rem) 20vw, 7.5rem"
                format="webp"
                loading="lazy"
                decoding="async"
              />
            </div>
            <div class="landing-activities__body">
              <h3 class="landing-activities__name">{name}</h3>
              <p class="landing-activities__text">{text}</p>
            </div>
          </li>
        ))}
      </ul>

      <div class="landing-activities__more">
        <Button href={localizePath('/activities', Astro.currentLocale)} variant="secondary">
          <span>{t('cta.viewActivities')}</span>
          <Icon name="arrow-right" class="landing__cta-icon" />
        </Button>
      </div>
    </div>
  </section>
)}
