---
// HomeGallery.astro - Home gallery section: a static photo grid with zoomable images.
// Renders all 6 entries of the structured `gallery` collection, in `order` — the reveal
// stagger in _home-gallery.scss is sized to exactly 6 cards.
import { getCollection } from 'astro:content';
import { getImage } from 'astro:assets';
import HomeGalleryScroller from '../../islands/HomeGalleryScroller.jsx';
import { useTranslations, defaultLocale } from '../../i18n';

const t = useTranslations(defaultLocale);
const entries = (await getCollection('gallery')).sort((a, b) => a.data.order - b.data.order);
const sizes = '(max-width: 48rem) 92vw, (max-width: 75rem) 50vw, 33vw';
const labels = [
  t('home.gallery.card.1'),
  t('home.gallery.card.2'),
  t('home.gallery.card.3'),
  t('home.gallery.card.4'),
  t('home.gallery.card.5'),
  t('home.gallery.card.6'),
];
const images = await Promise.all(
  entries.map(async ({ data }, index) => {
    const optimized = await getImage({
      src: data.src,
      widths: index === 0 ? [720, 1100, 1500] : [480, 760, 1100],
      sizes,
      format: 'webp',
    });

    return {
      src: optimized.src,
      srcset: optimized.srcSet.attribute,
      sizes,
      width: data.src.width,
      height: data.src.height,
      alt: data.alt,
      label: labels[index],
    };
  })
);
---

{/*
  The `.reveal` hook lives on this .astro wrapper, NOT on the island's own root element: the
  scroll-reveal observer adds `is-revealed` to it, and a node React owns must never be mutated
  from the outside — if hydration ever re-created the island root, the class (and with it the
  cards' visibility) would be lost and the gallery would stay blank until a reload.
*/}
<div class="home-gallery-reveal reveal">
<HomeGalleryScroller
  client:visible
  title={t('home.gallery.title')}
  intro={t('home.gallery.intro')}
  openLabel={t('home.gallery.open')}
  closeLabel={t('home.gallery.close')}
  outroTitle={t('home.gallery.outro.title')}
  outroText={t('home.gallery.outro.text')}
  ctaLabel={t('home.gallery.outro.cta')}
  images={images}
/>
</div>


